SECRET_KEY=replace-with-a-unique-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=
SITE_URL=http://127.0.0.1:8000

# Local email delivery through a Gmail account (use a Google App Password, not your
# regular account password). Enable 2-Step Verification to create an App Password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=GarageLog <your-gmail-address@gmail.com>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password

# Alternatively, use the Gmail API backend with OAuth credentials:
# EMAIL_BACKEND=accounts.gmail_email.GmailEmailBackend
# DEFAULT_FROM_EMAIL=GarageLog <your-gmail-address@gmail.com>
# GMAIL_CLIENT_ID=your-google-oauth-client-id
# GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
# GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token
# GMAIL_API_TIMEOUT=10
